rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'admin@estatecrm.com'
      );
    }

    function isAgent() {
      return isAuthenticated() && (
        getUserData().role == 'agent' ||
        isAdmin()
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // USERS COLLECTION RULES
    // ==========================================
    match /users/{userId} {
      // Any authenticated user can read profiles (needed for agent name lookup)
      allow read: if isAuthenticated();

      // Only Admin can create or update user roles
      allow create, update: if isAdmin();

      // Users can update their own phone or displayName, but NEVER change their role
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive']));

      // Only Admin can delete users
      allow delete: if isAdmin();
    }

    // ==========================================
    // PROPERTIES COLLECTION RULES
    // ==========================================
    match /properties/{propertyId} {
      // 1. READ: Allowed for all authenticated users (Admin, Agent, Viewer)
      // Unauthenticated access is strictly DENIED
      allow read: if isAuthenticated();

      // 2. CREATE: Allowed only for Admin and Agents
      allow create: if isAgent()
                    // Must not impersonate creator
                    && request.resource.data.createdBy == request.auth.uid
                    // Required schema fields validation
                    && request.resource.data.code is string
                    && request.resource.data.address is string
                    && request.resource.data.purpose is string
                    && request.resource.data.locationName is string
                    && request.resource.data.price is number
                    && request.resource.data.area is number;

      // 3. UPDATE: Allowed for Admin and Agents
      allow update: if isAgent()
                    // Client CANNOT tamper with original creation audit
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    // Must record updater
                    && request.resource.data.updatedBy == request.auth.uid;

      // 4. DELETE: Allowed ONLY for Admin
      allow delete: if isAdmin();
    }
  }
}
